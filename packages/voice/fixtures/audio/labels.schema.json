{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gavel.invalid/schemas/voice-audio-labels.json",
  "title": "Voice audio fixture labels (labels.json)",
  "type": "array",
  "minItems": 24,
  "items": { "$ref": "#/definitions/label" },
  "definitions": {
    "cents": { "type": "integer", "minimum": 0 },
    "candidate": {
      "type": "object",
      "required": ["amountCents"],
      "additionalProperties": false,
      "properties": {
        "paddle": { "type": "string", "minLength": 1 },
        "bidderId": { "type": "string", "minLength": 1 },
        "amountCents": { "$ref": "#/definitions/cents" }
      }
    },
    "label": {
      "type": "object",
      "required": [
        "id",
        "file",
        "transcript",
        "category",
        "voice",
        "noise",
        "speakerBidderId",
        "context",
        "expected",
        "acceptableConfirm"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^a[0-9]{2,3}$" },
        "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.wav$" },
        "transcript": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "noise": {
          "type": "object",
          "required": ["type", "snrDb"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["none", "cafe", "crowd"] },
            "snrDb": { "type": ["number", "null"] }
          }
        },
        "speakerBidderId": { "type": ["string", "null"] },
        "context": {
          "type": "object",
          "required": ["currentPriceCents", "minIncrementCents"],
          "additionalProperties": false,
          "properties": {
            "currentPriceCents": { "$ref": "#/definitions/cents" },
            "minIncrementCents": { "$ref": "#/definitions/cents" },
            "pendingCandidate": { "$ref": "#/definitions/candidate" }
          }
        },
        "expected": {
          "type": "object",
          "required": ["outcome"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "enum": ["bid", "confirm", "none"] },
            "paddle": { "type": "string", "minLength": 1 },
            "amountCents": { "$ref": "#/definitions/cents" },
            "intended": { "$ref": "#/definitions/candidate" }
          }
        },
        "acceptableConfirm": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/candidate" }
          }
        }
      }
    }
  }
}

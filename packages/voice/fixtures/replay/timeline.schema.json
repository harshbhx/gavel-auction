{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayTimeline",
  "description": "Timeline for a voice replay clip (R-VOX-083).",
  "type": "object",
  "required": ["utterances"],
  "additionalProperties": false,
  "properties": {
    "utterances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["startMs", "endMs", "expected"],
        "additionalProperties": false,
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "expected": {
            "type": "string",
            "enum": ["bid", "confirm", "none"]
          },
          "cachedEvents": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}

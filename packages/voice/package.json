{
  "name": "@gavel/voice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "size": "size-limit",
    "eval": "vite-node scripts/eval.ts --",
    "scan:secrets": "node --experimental-strip-types scripts/secret-scan.ts",
    "check:heldout": "node --experimental-strip-types scripts/check-heldout.ts"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "11.1.6",
    "@types/node": "22.10.2",
    "eslint": "9.15.0",
    "size-limit": "11.1.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.8"
  }
}

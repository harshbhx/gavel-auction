# Local development values for the web app. These are public, fake-money settings, not secrets.
# Vite does not read this file by name: copy it to .env.local, then run `npm run dev -w @gavel/web`.
#   cp packages/web/.env.example packages/web/.env.local
# They point at the server from the root README Quick start (port 8080, PAYMENTS=fake).
VITE_API_BASE=http://localhost:8080
VITE_WS_BASE=ws://localhost:8080
VITE_SANDBOX=true
VITE_PAYMENTS=fake

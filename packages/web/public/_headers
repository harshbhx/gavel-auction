# Response headers for the static web app, served by the Cloudflare Worker (infra/web/wrangler.toml).
# The Content-Security-Policy meta tag in index.html carries the source lists; this header adds the
# directive a meta tag cannot carry (frame-ancestors) and the transport and hardening headers.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), microphone=(self), usb=()
  X-Frame-Options: DENY

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry page is always revalidated, so a new deploy reaches returning visitors at once.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# security.txt (RFC 9116) is a real file, always plain text, never the app's HTML fallback.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Landing screenshots keep their names, so they cache for a week instead of revalidating each visit.
/landing/*
  Cache-Control: public, max-age=604800

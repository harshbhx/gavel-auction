{
  "name": "@gavel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:a11y": "playwright test a11y keyboard motion responsive",
    "test:screens": "playwright test -c playwright.screens.config.ts",
    "test:screens:live": "playwright test -c playwright.screens.live.config.ts",
    "screens:index": "node test/screens/build-index.mjs ui-screens-out",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-size.mjs dist"
  },
  "dependencies": {
    "@gavel/shared": "0.1.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "4.10.2",
    "fast-check": "3.23.1",
    "jsdom": "31.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}

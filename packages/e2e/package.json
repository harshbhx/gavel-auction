{
  "name": "@gavel/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Scenario DSL, runner and end-to-end specs for Gavel",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p .",
    "test:browser": "playwright test",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "measure:sandbox": "vite-node src/sandbox/measure-cli.ts --",
    "measure:settlement": "vite-node src/sandbox/measure-settlement-cli.ts --",
    "report:sandbox": "vite-node src/report/sandbox-cli.ts",
    "gate:g5": "vite-node src/gates/g5-cli.ts --"
  },
  "dependencies": {
    "@gavel/engine": "0.1.0",
    "@gavel/payments": "0.0.0",
    "@gavel/server": "0.1.0",
    "@gavel/shared": "0.1.0",
    "@gavel/voice": "0.0.0",
    "yaml": "2.6.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.10.2",
    "fast-check": "3.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

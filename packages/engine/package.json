    "check:bundle": "node scripts/bundle-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fast-check": "3.23.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "bin": {
    "verify-ledger": "./bin/verify-ledger.mjs"
  }
}

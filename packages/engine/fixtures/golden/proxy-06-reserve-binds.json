{
  "name": "proxy: single bid above reserve pays reserve",
  "parity": true,
  "config": {
    "mode": "proxy",
    "reserve": 5000,
    "minIncrement": 100,
    "endTs": 100000
  },
  "steps": [
    {
      "op": "register",
      "at": 0,
      "bidder": "a",
      "ceiling": 100000
    },
    {
      "op": "register",
      "at": 0,
      "bidder": "b",
      "ceiling": 100000
    },
    {
      "op": "bid",
      "at": 1000,
      "bidder": "a",
      "amount": 8000
    },
    {
      "op": "bid",
      "at": 2000,
      "bidder": "b",
      "amount": 4000
    },
    {
      "op": "hammer",
      "at": 100000
    }
  ],
  "expect": {
    "winner": "a",
    "price": 5000,
    "ranking": [["a", 8000]],
    "rejects": ["below_reserve"],
    "endsAt": 100000
  }
}

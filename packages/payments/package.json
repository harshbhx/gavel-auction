{
  "name": "@gavel/payments",
  "version": "0.0.0",
  "private": true,
  "description": "PayPal sandbox authorize-and-capture payments for Gavel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake/server.ts",
    "./contract/web": "./src/contract/web.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check:deps": "node -e \"const d=Object.keys(require('./package.json').dependencies||{});const bad=d.filter(x=>x!=='zod');if(bad.length){console.error('forbidden runtime dependencies: '+bad.join(', '));process.exit(1)}\"",
    "gate:g0": "vite-node gates/g0.ts --",
    "gate:g1": "vite-node gates/g1.ts --",
    "gate:g1-observe": "vite-node gates/g1-observe.ts --",
    "gate:g2": "vite-node gates/g2/server.ts --",
    "gate:g3": "vite-node gates/g3.ts --",
    "gate:g4": "vite-node gates/g4.ts --",
    "gate:g4-tamper": "vite-node gates/g4-tamper.ts --",
    "gate:g4-events": "vite-node gates/g4-events.ts --",
    "gate:idem": "vite-node gates/idempotency.ts --",
    "measure": "vite-node gates/measure.ts --",
    "demo:settle": "vite-node demo/settle-with-crash.ts --"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@gavel/engine": "0.1.0",
    "@types/node": "22.20.5",
    "fast-check": "3.23.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}

{
  "name": "@gavel/payments",
  "version": "0.0.0",
  "private": true,
  "description": "PayPal sandbox authorize-and-capture payments for Gavel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "check:deps": "node -e \"const d=Object.keys(require('./package.json').dependencies||{});const bad=d.filter(x=>x!=='zod');if(bad.length){console.error('forbidden runtime dependencies: '+bad.join(', '));process.exit(1)}\"",
    "gate:g1": "echo \"gate g1: not implemented yet\" >&2 && exit 1",
    "gate:g2": "echo \"gate g2: not implemented yet\" >&2 && exit 1",
    "gate:g3": "echo \"gate g3: not implemented yet\" >&2 && exit 1",
    "gate:idem": "vite-node gates/idempotency.ts",
    "measure": "vite-node gates/measure.ts"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "fast-check": "3.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}

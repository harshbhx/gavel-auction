{
  "name": "@gavel/payments",
  "version": "0.0.0",
  "private": true,
  "description": "PayPal sandbox authorize-and-capture payments for Gavel",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p .",
    "check:deps": "node -e \"const d=Object.keys(require('./package.json').dependencies||{});const bad=d.filter(x=>x!=='zod');if(bad.length){console.error('forbidden runtime dependencies: '+bad.join(', '));process.exit(1)}\"",
    "gate:g1": "echo \"gate g1: not implemented yet\"",
    "gate:g2": "echo \"gate g2: not implemented yet\"",
    "gate:g3": "echo \"gate g3: not implemented yet\"",
    "measure": "echo \"measure: not implemented yet\""
  },
  "dependencies": { "zod": "3.23.8" },
  "devDependencies": {
    "@types/node": "20.14.10",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}

    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vite-node": "2.1.8",
    "vitest": "2.1.8"
  }

{
  "name": "@gavel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "vite-node src/main.ts",
    "start:prod": "node dist/main.js",
    "bench": "vite-node bench/latency.ts",
    "bench:webhook-handler": "vite-node bench/webhook-handler.ts --",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:trace": "node scripts/trace-check.mjs"
  },
  "dependencies": {
    "@gavel/engine": "0.1.0",
    "@gavel/payments": "0.0.0",
    "@gavel/shared": "0.1.0",
    "@gavel/voice": "0.0.0",
    "pg": "8.23.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vite-node": "5.3.0",
    "vitest": "4.1.11"
  }
}

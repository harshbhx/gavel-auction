{
  "name": "gavel",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project 'unit:*'",
    "test:pkg": "vitest run --passWithNoTests --project",
    "test:coverage": "vitest run --coverage --project 'unit:*' && node scripts/check-coverage.mjs",
    "test:property": "vitest run --project 'property:*'",
    "test:scenarios": "vitest run --project 'unit:e2e'",
    "test:e2e": "echo 'test:e2e: not implemented' && exit 1",
    "test:e2e:sandbox": "echo 'test:e2e:sandbox: not implemented' && exit 1",
    "test:load": "echo 'test:load: not implemented' && exit 1",
    "report": "echo 'report: not implemented' && exit 1",
    "check:secrets": "npm run build -w @gavel/web && node scripts/check-bundle-secrets.mjs --require-dir --canaries-from-env",
    "check:deps": "depcruise packages --config .dependency-cruiser.cjs && node scripts/check-engine-purity.mjs && npm run check:deps -w @gavel/payments",
    "check:live-host": "node scripts/check-no-live-host.mjs",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:banned-words": "node scripts/check-banned-words.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:gates-result": "node scripts/check-gates-result.mjs",
    "test:tools": "node --test \"scripts/tests/*.test.mjs\" \"eslint.rules/tests/*.test.mjs\" \"packages/server/eslint-rules/*.test.mjs\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@eslint/js": "9.15.0",
    "@vitest/coverage-v8": "2.1.8",
    "dependency-cruiser": "16.8.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  }
}

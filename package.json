{
  "name": "gavel",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'test: not implemented'",
    "test:pkg": "echo 'test:pkg: not implemented'",
    "test:coverage": "echo 'test:coverage: not implemented'",
    "test:property": "echo 'test:property: not implemented'",
    "test:scenarios": "echo 'test:scenarios: not implemented'",
    "test:e2e": "echo 'test:e2e: not implemented'",
    "test:e2e:sandbox": "echo 'test:e2e:sandbox: not implemented'",
    "test:load": "echo 'test:load: not implemented'",
    "report": "echo 'report: not implemented'",
    "check:secrets": "echo 'check:secrets: not implemented'",
    "check:deps": "echo 'check:deps: not implemented'",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:banned-words": "node scripts/check-banned-words.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "test:tools": "node --test \"scripts/tests/*.test.mjs\" \"eslint.rules/tests/*.test.mjs\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0"
  }
}

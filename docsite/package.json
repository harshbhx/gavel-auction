{
  "name": "gavel-docsite",
  "version": "1.0.0",
  "private": true,
  "description": "The GAVEL documentation website (Fumadocs, Next.js static export).",
  "scripts": {
    "gen": "node scripts/gen-repo-data.mjs && node scripts/gen-changelog.mjs",
    "prebuild": "node scripts/gen-repo-data.mjs && node scripts/gen-changelog.mjs",
    "build": "next build",
    "dev": "node scripts/gen-repo-data.mjs && node scripts/gen-changelog.mjs && next dev",
    "start": "serve out",
    "types:check": "node scripts/gen-repo-data.mjs && node scripts/gen-changelog.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.3",
    "lucide-react": "^1.50.0",
    "mermaid": "12.3.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

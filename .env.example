# Names the project reads. Copy to .env and fill in; never commit real values.
# Empty means unset. Use PayPal sandbox values only.

# Server (packages/server)
PORT=
PUBLIC_URL=
NODE_ENV=
TOKEN_SECRET=
TOKEN_SECRET_PREVIOUS=
TOKEN_SECRET_PREVIOUS_UNTIL=
ADMIN_KEY=
STORE=
DATA_DIR=
DATABASE_URL=
CORS_ORIGINS=
WEB_ORIGIN=
LOG_LEVEL=
DEMO_MODE=
DEMO_MAX_ROOMS=
JUDGE_ROOMS=
JUDGE_ROOMS_PAUSED=
JUDGE_SIM_HOLDS=
JUDGE_ROOMS_MAX=
JUDGE_ROOM_TTL_MS=
JUDGE_ROOMS_PER_IP_HOUR=
JUDGE_ROOMS_PER_HOUR=
JUDGE_KEY=
JUDGE_KEY_ROOMS_MAX=
ALLOW_MEMORY_STORE=
RATE_BID_PER_S=
RATE_BID_BURST=
RATE_JOIN_PER_MIN=
RATE_JOIN_BURST=
RATE_HTTP_PER_MIN=
RATE_HTTP_BURST=
RATE_HTTP_READ_PER_MIN=
RATE_HTTP_READ_BURST=
TRUSTED_PROXY_HOPS=
MAX_CONN_PER_BIDDER=
MAX_CONN_PER_ROOM=
MAX_BIDDERS_PER_ROOM=
MAX_ROOMS=
MAX_BIDS_PER_AUCTION=

# Payments: PAYMENTS is the one switch (fake = in-process fake PayPal, sandbox = PayPal sandbox).
# For the web build set VITE_PAYMENTS to match (fake for PAYMENTS=fake, paypal for sandbox).
PAYMENTS=fake
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=
GAVEL_MAX_CEILING_CENTS=
GAVEL_HOLD_MAX_AGE_MS=
GAVEL_RECONCILE_INTERVAL_MS=
GAVEL_RECONCILE_REPAIR=0
GAVEL_REAUTH=0
GAVEL_REAUTH_HONOR_SAFE_MS=

# Voice and language model
# Speech provider for /audio: replay (default, cached, no key), fake, groq (needs GROQ_API_KEY) or deepgram (needs DEEPGRAM_API_KEY)
VOICE_STT=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
LLM_API_KEY=

# Sandbox specs and gates (packages/e2e/sandbox, nightly workflow). Absent means the spec is skipped.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
SANDBOX_CARD_BUYER_EMAIL=
SANDBOX_CARD_BUYER_PASSWORD=
GAVEL_STAGING_URL=
GAVEL_STAGING_ADMIN_KEY=
G5_AUDIO_DIR=

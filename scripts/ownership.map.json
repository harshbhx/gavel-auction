{
  "exempt": ["package-lock.json", "**/*.tsbuildinfo", "**/dist/**", "**/*.d.ts", "etc/*.api.md"],
  "bypassLabel": "cross-area",
  "areas": {
    "ENG": ["packages/engine/**", "docs/specs/engine/**"],
    "PAY": ["packages/payments/**", "docs/GATES.md", "docs/specs/payments/**"],
    "RT": ["packages/shared/**", "packages/server/**", "docs/specs/realtime/**"],
    "VOI": ["packages/voice/**", "docs/specs/voice/**"],
    "VOX": ["packages/voice/**", "docs/specs/voice/**"],
    "WEB": ["packages/web/**", "docs/specs/web/**"],
    "QA": [
      "packages/e2e/**",
      "infra/**",
      ".github/**",
      "scripts/**",
      "docs/DECISIONS.md",
      "docs/GATES.md",
      "docs/specs/quality/**",
      "package.json",
      "tsconfig.json",
      "tsconfig.base.json",
      "eslint.config.js",
      ".prettierrc.json",
      ".prettierignore",
      ".editorconfig",
      ".nvmrc",
      ".npmrc",
      ".gitignore",
      ".gitleaks.toml",
      "CONTRIBUTING.md"
    ]
  }
}

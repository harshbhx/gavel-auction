{
  "dataset": "gavel-latency",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "note": "Built directly from docs/evidence (no hand-copied inputs): adds the 50-settlement run 42563147792 and its 60 per-call cycles, which missed both targets; every row carries attempts, failures, a worst-case p95 over all attempts, the target and a MET/MISSED/UNPROVEN status."
    },
    {
      "version": "1.0.0",
      "note": "First release: sandbox settlement spans (3 and 20 settlements) and per-call latency (10 cycles)."
    }
  ],
  "tables": {
    "settlement_spans.jsonl": {
      "source": "docs/evidence/latency and docs/evidence/measure (redacted measure-sandbox settlement summaries)",
      "rows": {
        "min": 4
      },
      "primaryKey": ["run_id", "span"],
      "fields": {
        "run_id": "integer",
        "run_label": "string",
        "run_date": "string?",
        "span": "string",
        "n": "integer",
        "failures": "integer",
        "attempts": "integer",
        "p95_all_attempts_ms": "number?",
        "target_p95_ms": "integer",
        "met": "boolean",
        "status": "string",
        "min_ms": "number",
        "p50_ms": "number",
        "p95_ms": "number",
        "p99_ms": "number",
        "max_ms": "number",
        "holds_per_settlement": "integer",
        "void_concurrency": "integer",
        "mismatches": "integer",
        "errors": "integer",
        "source_path": "string"
      },
      "min": {
        "n": 1,
        "failures": 0,
        "min_ms": 0,
        "mismatches": 0,
        "errors": 0
      },
      "enum": {
        "span": ["hammer_to_captured", "hammer_to_settled"],
        "status": ["MET", "MISSED", "UNPROVEN"]
      }
    },
    "api_calls.jsonl": {
      "source": "docs/evidence/latency (redacted per-call summary of the same workflow run)",
      "rows": {
        "min": 4
      },
      "primaryKey": ["run_id", "call"],
      "fields": {
        "run_id": "integer",
        "run_date": "string?",
        "call": "string",
        "n": "integer",
        "failures": "integer",
        "attempts": "integer",
        "p95_all_attempts_ms": "number?",
        "target_p95_ms": "integer",
        "met": "boolean",
        "status": "string",
        "min_ms": "number",
        "p50_ms": "number",
        "p95_ms": "number",
        "p99_ms": "number",
        "max_ms": "number",
        "cycles": "integer",
        "source_path": "string"
      },
      "min": {
        "n": 1,
        "failures": 0,
        "p50_ms": 0
      },
      "enum": {
        "call": ["order", "authorize", "capture", "void"],
        "status": ["MET", "MISSED", "UNPROVEN"]
      }
    }
  }
}
